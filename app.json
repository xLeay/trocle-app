{
    "expo": {
        "name": "Trocle",
        "slug": "trocle-app",
        "scheme": "trocle-app",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "light",
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.xleay.trocleapp"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/icon-android-foreground.png",
                "backgroundImage": "./assets/icon-android-background.png",
                "backgroundColor": "#14B814"
            },
            "package": "com.xleay.trocleapp"
        },
        "web": {
            "favicon": "./assets/favicon.png"
        },
        "extra": {
            "eas": {
                "projectId": "b52eb11b-3652-475e-955b-da64b0c69095"
            }
        },
        "owner": "xleay",
        "plugins": [
            [
                "expo-font",
                {
                    "fonts": [
                        "./assets/fonts/Rethink_Sans/RethinkSans-VariableFont_wght.ttf",
                        "./assets/fonts/Rethink_Sans/RethinkSans-Italic-VariableFont_wght.ttf",
                        "./assets/fonts/Rethink_Sans/RethinkSans-Regular.ttf",
                        "./assets/fonts/Rethink_Sans/RethinkSans-Italic.ttf",
                        "./assets/fonts/Rethink_Sans/RethinkSans-Medium.ttf",
                        "./assets/fonts/Rethink_Sans/RethinkSans-MediumItalic.ttf",
                        "./assets/fonts/Rethink_Sans/RethinkSans-SemiBold.ttf",
                        "./assets/fonts/Rethink_Sans/RethinkSans-SemiBoldItalic.ttf",
                        "./assets/fonts/Rethink_Sans/RethinkSans-Bold.ttf",
                        "./assets/fonts/Rethink_Sans/RethinkSans-BoldItalic.ttf",
                        "./assets/fonts/Rethink_Sans/RethinkSans-ExtraBold.ttf",
                        "./assets/fonts/Rethink_Sans/RethinkSans-ExtraBoldItalic.ttf"
                    ]
                }
            ],
            "expo-router",
            [
                "react-native-edge-to-edge",
                {
                    "android": {
                        "parentTheme": "Default",
                        "enforceNavigationBarContrast": false
                    }
                }
            ],
            [
                "expo-location",
                {
                    "locationAlwaysAndWhenInUsePermission": "Autoriser Trocle à accéder à votre position."
                }
            ],
            "expo-image",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/splash.png",
                    "resizeMode": "cover",
                    "backgroundColor": "#14B814"
                }
            ]
        ]
    }
}